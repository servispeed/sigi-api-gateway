{
  "info": {
    "_postman_id": "84844aa1-bc5a-4b9e-bcc5-d2a3f726e871",
    "name": "SIGI Integration HTTP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "20748076"
  },
  "item": [
    {
      "name": "1. Login (Security)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {\r\n    var jsonData = pm.response.json();\r\n    pm.environment.set(\"jwt_token\", jsonData.token);\r\n    console.log(\"Token JWT guardado en el entorno local.\");\r\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"email\": \"isaias04@gmail.com\",\r\n    \"password\": \"IsaiasJA04\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Launch event (Notifications)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/test/disparar-vencimientos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "test",
            "disparar-vencimientos"
          ]
        }
      },
      "response": []
    }
  ]
}